# Wajib di-set di Railway (production). Kosongin/skip di local dev kalau males.

# Secret buat header x-api-key. Generate random string yang panjang, misal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=secret

# Domain web lo yang boleh akses (comma-separated, tanpa trailing slash)
ALLOWED_ORIGINS=https://tsukinest.my.id
